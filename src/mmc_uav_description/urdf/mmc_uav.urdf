<gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/model/mmc_uav/joint_state</topic>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>joint_slider_blue</joint_name>
      <topic>/model/mmc_uav/joint/joint_slider_blue/cmd_pos</topic>
      <p_gain>8.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>2.1</d_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>joint_slider_red</joint_name>
      <topic>/model/mmc_uav/joint/joint_slider_red/cmd_pos</topic>
      <p_gain>8.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>2.1</d_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>joint_slider_green</joint_name>
      <topic>/model/mmc_uav/joint/joint_slider_green/cmd_pos</topic>
      <p_gain>8.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>2.1</d_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>joint_slider_purple</joint_name>
      <topic>/model/mmc_uav/joint/joint_slider_purple/cmd_pos</topic>
      <p_gain>8.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>2.1</d_gain>
    </plugin>

    <plugin
      filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>mmc_uav</robotNamespace>
      <jointName>joint_rotor_upper</jointName>
      <linkName>rotor_upper_link</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.01</timeConstantUp>
      <timeConstantDown>0.02</timeConstantDown>
      <maxRotVelocity>400.0</maxRotVelocity>
      <motorConstant>1.5e-4</motorConstant>
      <momentConstant>0.002</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <actuator_number>0</actuator_number>
      <rotorDragCoefficient>0.0</rotorDragCoefficient>
      <rollingMomentCoefficient>0.0</rollingMomentCoefficient>
      <motorSpeedPubTopic>motor_speed/upper</motorSpeedPubTopic>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin
      filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>mmc_uav</robotNamespace>
      <jointName>joint_rotor_lower</jointName>
      <linkName>rotor_lower_link</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.01</timeConstantUp>
      <timeConstantDown>0.02</timeConstantDown>
      <maxRotVelocity>400.0</maxRotVelocity>
      <motorConstant>1.275e-4</motorConstant>
      <momentConstant>0.002</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <actuator_number>1</actuator_number>
      <rotorDragCoefficient>0.0</rotorDragCoefficient>
      <rollingMomentCoefficient>0.0</rollingMomentCoefficient>
      <motorSpeedPubTopic>motor_speed/lower</motorSpeedPubTopic>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>mmc_world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_publish_frequency>100</odom_publish_frequency>
      <odom_topic>/model/mmc_uav/odometry</odom_topic>
      <dimensions>3</dimensions>
    </plugin>

    </gazebo>

  <gazebo reference="base_link">
    <enable_wind>true</enable_wind>
    <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>250</update_rate>
      <visualize>true</visualize>
      <topic>/imu</topic>
    </sensor>
  </gazebo>





</robot>
