      </geometry>
    </collision>
  </link>
  <joint name="joint_slider_green" type="prismatic">
    <origin xyz="1.2765511418678223e-10 0.17999062882058608 -0.029733327586206885" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="slider_green_link" />
    <axis xyz="-1 0 0" />
    <limit lower="-0.15" upper="0.15" effort="2.0" velocity="0.25" />
  </joint>
  <link name="rotor_lower_link">
    <inertial>
      <origin xyz="-2.0106E-08 2.0768E-08 -0.00042643" rpy="0 0 0" />
      <mass value="0.1" />
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://mmc_uav_description/meshes/rotor_lower_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.8 0.8 0.3 1" />
