  <joint name="joint_slider_red" type="prismatic">
    <origin xyz="-0.17999999987234488 0.00011205882058608802 -0.029733327586206885" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="slider_red_link" />
    <axis xyz="0 1 0" />
    <limit lower="-0.15" upper="0.15" effort="2.0" velocity="0.25" />
  </joint>
  <link name="slider_purple_link">
    <inertial>
      <origin xyz="2.4016E-06 -0.0017202 0.028256" rpy="0 0 0" />
      <mass value="0.05" />
      <inertia ixx="0.0006" ixy="0" ixz="0" iyy="0.0006" iyz="0" izz="0.0012" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://mmc_uav_description/meshes/slider_purple_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.6 0.2 0.6 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://mmc_uav_description/meshes/slider_purple_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="joint_slider_purple" type="prismatic">
    <origin xyz="1.2765511418678223e-10 -0.1800093711794139 -0.029733327586206885" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="slider_purple_link" />
    <axis xyz="-1 0 0" />
    <limit lower="-0.15" upper="0.15" effort="2.0" velocity="0.25" />
  </joint>
  <link name="slider_green_link">
    <inertial>
      <origin xyz="-2.4016E-06 0.0017202 0.028256" rpy="0 0 0" />
      <mass value="0.05" />
      <inertia ixx="0.0006" ixy="0" ixz="0" iyy="0.0006" iyz="0" izz="0.0012" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
