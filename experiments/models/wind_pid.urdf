<?xml version='1.0' encoding='utf-8'?>
<robot name="mmc_uav_description">

  <link name="base_link">
    <inertial>
      <origin xyz="1.2765519429778223e-10 -9.3711794137482222e-06 0.00023637241379311641" rpy="0 0 0" />
      <mass value="1.05" />
      <inertia ixx="0.0585" ixy="0" ixz="0" iyy="0.0585" iyz="0" izz="0.06" />
    </inertial>
    <visual>
      <origin xyz="1.2765511418678223e-10 -9.3711794139119825e-06 -0.034763627586206887" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://mmc_uav_description/meshes/base_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.65 0.65 0.65 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="1.2765511418678223e-10 -9.3711794139119825e-06 -0.034763627586206887" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://mmc_uav_description/meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>
  <link name="rotor_upper_link">
    <inertial>
      <origin xyz="1.8255E-08 6.3335E-09 0.00042643" rpy="0 0 0" />
      <mass value="0.1" />
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://mmc_uav_description/meshes/rotor_upper_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.8 0.8 0.3 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://mmc_uav_description/meshes/rotor_upper_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="joint_rotor_upper" type="continuous">
    <origin xyz="1.2765511418678223e-10 -9.3711794139119825e-06 0.015236372413793116" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="rotor_upper_link" />
    <axis xyz="0 0 1" />
    <limit effort="100" velocity="400" />
  </joint>
  <link name="slider_blue_link">
    <inertial>
      <origin xyz="0.0017202 2.4016E-06 0.028256" rpy="0 0 0" />
      <mass value="0.05" />
      <inertia ixx="0.0006" ixy="0" ixz="0" iyy="0.0006" iyz="0" izz="0.0012" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://mmc_uav_description/meshes/slider_blue_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.2 0.4 0.8 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://mmc_uav_description/meshes/slider_blue_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="joint_slider_blue" type="prismatic">
    <origin xyz="0.1800000001276551 0.00014090882058608801 -0.029733327586206885" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="slider_blue_link" />
    <axis xyz="0 1 0" />
    <limit lower="-0.15" upper="0.15" effort="2.0" velocity="0.25" />
  </joint>
  <link name="slider_red_link">
    <inertial>
      <origin xyz="-0.0017202 -2.4016E-06 0.028256" rpy="0 0 0" />
      <mass value="0.05" />
      <inertia ixx="0.0006" ixy="0" ixz="0" iyy="0.0006" iyz="0" izz="0.0012" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://mmc_uav_description/meshes/slider_red_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.8 0.1 0.1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://mmc_uav_description/meshes/slider_red_link.STL" />
